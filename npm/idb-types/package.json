{
    "name": "@appetizeio/idb-types",
    "version": "1.5.0",
    "description": "idb.proto and the TypeScript types generated from it",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/appetizeio/idb.git",
        "directory": "npm/idb-types"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "files": [
        "dist",
        "proto"
    ],
    "exports": {
        "./proto/*": "./proto/*",
        "./*": "./dist/*"
    },
    "scripts": {
        "clean": "rm -rf src dist proto",
        "generate": "proto-loader-gen-types --grpcLib=@grpc/grpc-js --importFileExtension=.js --outDir=src ../../proto/*.proto",
        "build": "npm run clean && npm run generate && tsc && mkdir proto && cp ../../proto/*.proto proto/",
        "prepack": "npm run build"
    },
    "peerDependencies": {
        "@grpc/grpc-js": "^1.14.0",
        "@grpc/proto-loader": "^0.8.0"
    },
    "devDependencies": {
        "@grpc/grpc-js": "1.14.7",
        "@grpc/proto-loader": "0.8.1",
        "typescript": "5.9.3"
    }
}
