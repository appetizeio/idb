{
    "name": "@appetizeio/idb-proto",
    "version": "1.5.0",
    "description": "idb.proto and the TypeScript types generated from it",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/appetizeio/idb.git",
        "directory": "npm/idb-proto"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "files": [
        "dist"
    ],
    "exports": {
        "./*": "./dist/*"
    },
    "scripts": {
        "build": "run-s build:clean build:types build:proto tsc",
        "build:clean": "rm -rf src dist",
        "build:types": "proto-loader-gen-types --grpcLib=@grpc/grpc-js --importFileExtension=.js --outDir=src ../../proto/*.proto",
        "build:proto": "node scripts/generate-proto-module.js",
        "prepack": "pnpm run build",
        "tsc": "tsc"
    },
    "peerDependencies": {
        "@grpc/grpc-js": "^1.14.0",
        "@grpc/proto-loader": "^0.8.0"
    },
    "devDependencies": {
        "@grpc/grpc-js": "1.14.7",
        "@grpc/proto-loader": "0.8.1",
        "protobufjs": "7.6.6",
        "typescript": "5.9.3"
    }
}
