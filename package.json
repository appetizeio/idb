{
    "name": "idb",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm --recursive run build",
        "release": "pnpm --recursive publish --no-git-checks --tag latest",
        "validate": "run-s validate:*",
        "validate:porcelain": "git status --short && test -z \"$(git status --porcelain)\"",
        "version": "node npm/set-version.js"
    },
    "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24",
            "onFail": "warn"
        }
    },
    "devDependencies": {
        "npm-run-all2": "^9.0.4"
    }
}
